# ============================================================
# PeoplePay360 - Environment Configuration
# ============================================================

# --- Google Gemini ---
# Get an API key from https://aistudio.google.com/apikey
# NOTE: gemini-3.6-flash hits the free-tier daily quota fast (20 reqs/day).
# gemini-3.5-flash-lite has a separate quota and is a lighter, faster choice
# for this pipeline. Use a billing-enabled key for production.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Database (PostgreSQL) ---
# Used by src/db/schema.sql + seed.sql and by any service that connects to
# the real database. Format:
#   postgresql://user:password@host:port/peoplepay360
DATABASE_URL=postgresql://user:password@localhost:5432/peoplepay360

# --- Redis (BullMQ) ---
# Reserved for queueing; unused by the current pipeline.
REDIS_URL=redis://localhost:6379

# --- Google Cloud IAM ---
# Project where the custom IAM roles (hrManager, hrPayrollUser,
# hrPayrollManager) are created by gcp/iam/setup.*
GOOGLE_CLOUD_PROJECT=your-gcp-project-id